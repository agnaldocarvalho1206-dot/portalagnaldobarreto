# Copie para .env localmente. No EasyPanel, use o editor de ambiente.
# Nunca envie valores reais ao GitHub.
NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000
APP_URL=https://portal.example.com
DATABASE_URL=
# false somente na rede privada Docker/EasyPanel; true para banco remoto com TLS.
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Apenas no terminal/job de migração. Pode usar o mesmo banco com usuário DDL separado.
MIGRATION_DATABASE_URL=
# Somente para compose.yaml; gere uma senha aleatória e use a mesma na URL do banco.
POSTGRES_PASSWORD=
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_HMAC_SECRET=
# true apenas se o proxy remover e sobrescrever x-real-ip. Nunca exponha Node diretamente.
TRUST_PROXY=false
S3_ENDPOINT=https://storage.example.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
NEXT_TELEMETRY_DISABLED=1
